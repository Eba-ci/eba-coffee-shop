# /var/www/eba-coffee/.env.production — une ligne CLE=valeur, SANS guillemets (docker --env-file
# ne les retire pas), chmod 600. Point de départ : l'actuel /var/www/eba-coffee/.env (pm2).
# Pas d'APP_ENV (le deploy.sh le refuse) ; DATABASE_URL ne doit pas contenir « staging ».
TZ=UTC

# Postgres reste sur 127.0.0.1 ; le conteneur le joint par host.docker.internal (10.0.2.2).
DATABASE_URL=postgresql://CHANGE_ME@host.docker.internal:5432/CHANGE_ME
NEXT_PUBLIC_SITE_URL=https://eba-coffee.com

# Reprendre à l'identique de l'ancien .env : BETTER_AUTH_*, CRON_SECRET, RESEND_*, OWNER_EMAIL,
# ADMIN_EMAIL, CLOUDINARY_*, JEKO_* (+ JEKO_B_*), VAPID_*, OPENROUTER_*, MCP_API_KEY, GTM, Meta, Sentry…
# Le mock Jèko (JEKO_API_BASE_URL=…:4010) est réservé au staging.
