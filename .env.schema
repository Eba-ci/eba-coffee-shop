# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# @generateTypes(lang='ts', path='env.d.ts')
# @defaultSensitive=inferFromPrefix('NEXT_PUBLIC_')

# @type=url
DATABASE_URL=
# @type=url
# Racine publique du site (ex: https://eba-coffee.com). Un slash final est
# toléré : `siteUrl()` (lib/site-url.ts) le retire avant toute concaténation.
# Ne pas lire cette variable directement pour construire une URL — passer par
# `siteUrl()` / `normalizeSiteUrl()`, sinon on retombe sur les `…com//a-propos`
# du sitemap.
NEXT_PUBLIC_SITE_URL=
# @type=string
BETTER_AUTH_SECRET=
# @type=url
# @public
BETTER_AUTH_URL="${NEXT_PUBLIC_SITE_URL}"
# @type=string
RESEND_API_KEY=
# @type=string
RESEND_FROM=
# Adresses email (identifiants, pas des secrets) : elles transitent
# légitimement dans les réponses d'auth (user.email). On les marque
# non sensibles pour éviter le faux positif du scan anti-fuite de varlock
# (« DETECTED LEAKED SENSITIVE CONFIG ») qui bloquait la connexion admin.
# @type=string
# @sensitive=false
OWNER_EMAIL=
# @type=string
# @sensitive=false
ADMIN_EMAIL=
# @type=string
# @public
# Identifiant marchand Wave (ex: M_ci_MTkvxiIpuylE). Utilisé pour construire
# les liens de paiement `https://pay.wave.com/m/<ID>/c/ci/?amount=<montant>`.
# Si vide, les messages Wave WhatsApp incluent un placeholder à compléter.
NEXT_PUBLIC_WAVE_MERCHANT_ID=
# @type=string
# @optional
# Jeton d'accès « machine » au serveur MCP (/api/mcp), passé en
# `Authorization: Bearer <token>`. Secret (sensible par défaut). OPTIONNEL :
# pour les clients qui gèrent leurs en-têtes (Claude Code CLI, curl). Les
# clients Claude web/mobile passent par OAuth (rôle ADMIN) — voir
# `app/api/mcp/README.md`. Si non configurée, seul OAuth est actif. Générer une
# valeur aléatoire forte, ex. `openssl rand -hex 32`.
MCP_API_KEY=
# @type=string
# @optional
# Secret bearer OPTIONNEL pour déclencher le rappel d'inventaire depuis un cron
# externe : `POST /api/inventory/reminder-check` avec l'en-tête
# `Authorization: Bearer <CRON_SECRET>`. Si non configurée, la route est inerte
# (404). Générer une valeur aléatoire forte, ex. `openssl rand -hex 32`.
CRON_SECRET=
# @type=string
# @optional
# Clé API Jèko (X-API-KEY) pour le paiement en ligne (lib/jeko/client.ts).
# Secret. Il n'existe pas de sandbox : utiliser un magasin dédié aux tests.
# Si l'une des quatre variables JEKO_* manque, le paiement en ligne reste inerte.
JEKO_API_KEY=
# @type=string
# @optional
# Identifiant de la clé API Jèko (X-API-KEY-ID). Secret.
JEKO_API_KEY_ID=
# @type=string
# @optional
# Identifiant du magasin Jèko (storeId, UUID) qui encaisse les commandes.
JEKO_STORE_ID=
# @type=string
# @optional
# Secret de signature des webhooks Jèko : vérifie l'en-tête `Jeko-Signature`
# (HMAC-SHA256 du corps brut, lib/jeko/signature.ts). Secret.
JEKO_WEBHOOK_SECRET=
# @type=string
# @optional
# SECOND compte Jèko (B), mêmes rôles que JEKO_* (compte A). Les quatre variables
# JEKO_B_* doivent être renseignées pour pouvoir basculer dessus depuis
# /dashboard/jeko. Secrets.
JEKO_B_API_KEY=
# @type=string
# @optional
JEKO_B_API_KEY_ID=
# @type=string
# @optional
JEKO_B_STORE_ID=
# @type=string
# @optional
JEKO_B_WEBHOOK_SECRET=
# @type=url
# @sensitive=false
# @optional
# Racine de l'API Jèko. Absente = https://api.jeko.africa (production). Sert à
# pointer le site vers le serveur Jèko factice en local (`pnpm jeko:mock`,
# scripts/jeko-mock.ts) pour tester le paiement sans argent réel.
JEKO_API_BASE_URL=
# @type=number
# @sensitive=false
# @optional
# Frais de paiement en ligne facturés au client, en % du total (ex. 1 pour 1 %).
# Absente = 1. Jèko Checkout prélève 1,5 % : l'écart reste à la charge d'EBA.
ONLINE_FEE_PERCENT=
# @type=string
# @public
# @optional
# Clé publique VAPID (notifications push backoffice). Avec VAPID_PRIVATE_KEY,
# active l'abonnement push depuis le dashboard (nouvelle commande, commande
# prête). Si absente, la fonctionnalité reste inerte. Générer la paire avec
# `pnpm exec web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# @type=string
# @optional
# Clé privée VAPID associée à NEXT_PUBLIC_VAPID_PUBLIC_KEY. Secret (sensible par
# défaut) : ne jamais exposer côté client.
VAPID_PRIVATE_KEY=
# @type=string
# @sensitive=false
# @optional
# Identifiant de contact VAPID (obligatoire par la spec Web Push), ex.
# `mailto:contact@ebacoffeeshop.com`.
VAPID_SUBJECT=
# @type=string
# @public
# Nom du cloud Cloudinary. Non sensible : nécessaire côté navigateur pour
# poster directement vers https://api.cloudinary.com/v1_1/<cloud>/... (upload
# signé, sans passer par notre serveur). Dashboard Cloudinary > cloud name.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# @type=string
# @public
# Clé API Cloudinary. Non secrète en soi (seul CLOUDINARY_API_SECRET l'est) :
# nécessaire côté navigateur pour construire le POST d'upload signé.
# Dashboard Cloudinary > Settings > API Keys.
NEXT_PUBLIC_CLOUDINARY_API_KEY=
# @type=string
# Secret API Cloudinary, sert à SIGNER les paramètres d'upload côté serveur
# (dossier, transformation, formats autorisés). Ne jamais exposer côté
# client. Dashboard Cloudinary > Settings > API Keys.
CLOUDINARY_API_SECRET=
# @type=string
# @sensitive=false
# @optional
# Environnement de staging : `staging` (seule valeur reconnue). Coupe les e-mails,
# fixe le code de connexion à 000000, interdit l'indexation et refuse de démarrer
# si DATABASE_URL ne désigne pas une base « staging ». Laisser VIDE en production.
APP_ENV=
# @type=string
# @sensitive=false
# @optional
# Préfixe de dossier Cloudinary, isole dev/staging/prod dans le même compte
# (ex. "eba-coffee-shop"). Défaut si absent : "eba-coffee-shop-dev".
CLOUDINARY_FOLDER_PREFIX=
# @type=string
# @public
# @optional
# Identifiant du conteneur Google Tag Manager (ex. GTM-XXXXXXX), site public
# uniquement (le back-office n'est jamais mesuré). GA4 se configure COMME TAG
# À L'INTÉRIEUR du conteneur, depuis l'interface web de GTM, et non ici : un
# seul script chargé, pas de double comptage des page_view. Si cette variable
# est absente, aucun script de tracking n'est chargé et la bannière de
# consentement ne s'affiche pas (site 100% inerte).
NEXT_PUBLIC_GTM_ID=
# @type=string
# @public
# @optional
# Identifiant du pixel Meta / Facebook (15-16 chiffres, Gestionnaire
# d'événements Meta > Sources de données). Sert au reciblage publicitaire
# Facebook/Instagram. Le pixel n'est chargé QUE si le visiteur a accepté les
# cookies (cf. components/analytics/meta-pixel.tsx) : variable absente ou
# consentement refusé = aucun octet de Meta téléchargé.
NEXT_PUBLIC_META_PIXEL_ID=
# @type=string
# @sensitive=false
# @optional
# DSN du projet Sentry (runtimes server + edge). Absente = monitoring inerte.
SENTRY_DSN=
# @type=string
# @public
# @optional
# DSN du projet Sentry, exposé au navigateur (instrumentation-client.ts).
# Un DSN Sentry n'est pas un secret — il ne sert qu'à poster des events,
# jamais à les lire. Absente = aucun crash React côté client n'est capté.
NEXT_PUBLIC_SENTRY_DSN=
# @type=string
# @optional
# Jeton d'auth Sentry, upload des source maps en CI uniquement. Secret.
SENTRY_AUTH_TOKEN=
# @type=string
# @optional
# Clé API OpenRouter (https://openrouter.ai/keys) : active l'assistant IA du
# dashboard (lib/ai/assistant/). Secret. Absente = assistant inerte (la route
# /api/assistant répond 503 et le bouton n'est pas affiché).
OPENROUTER_API_KEY=
# @type=string
# @sensitive=false
# @optional
# Modèle OpenRouter de l'assistant (ex. google/gemini-3.1-flash-lite). Doit
# supporter les appels d'outils. Absent = valeur par défaut de lib/ai/config.ts.
OPENROUTER_MODEL=
